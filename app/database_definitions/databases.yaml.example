# Oracle API Hub — 資料庫連線定義
# 每個條目定義一個 Oracle 資料庫連線，alias 會成為 API 路徑的一部分。
# 例如：alias 為 "hr_db" 時，查詢端點為 POST /api/v1/hr_db/queries/execute
#
# 密碼可使用環境變數覆蓋：DB_{ALIAS}_PASSWORD（alias 大寫）
# 例如：DB_HR_DB_PASSWORD=secure_password

- alias: hr_db
  description: "HR 人力資源資料庫"
  dsn: "hr-oracle.company.com:1521/hrdb"
  user: "hr_api_user"
  password: "changeme"
  pool_min: 2
  pool_max: 10
  pool_increment: 1

- alias: finance_db
  description: "財務資料庫"
  dsn: "fin-oracle.company.com:1521/findb"
  user: "fin_api_user"
  password: "changeme"
  pool_min: 2
  pool_max: 5
  pool_increment: 1
