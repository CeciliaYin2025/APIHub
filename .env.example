# Data sources / targets are defined in app/database_definitions/databases.yaml.
# That file holds NO plaintext passwords — provide one per alias here as
# DB_{ALIAS_UPPER}_PASSWORD (alias from databases.yaml):
DB_DEFAULT_PASSWORD=changeme    # Oracle "default" alias
DB_PG_TEST_PASSWORD=changeme    # PostgreSQL "pg_test" alias

# Oracle Instant Client path (required for Oracle 11g thick mode; empty = thin)
ORACLE_CLIENT_DIR=

# Legacy single-DB vars below: only a fallback used when databases.yaml is
# absent. With the YAML present they are ignored.
ORACLE_DSN=localhost:1521/orcl
ORACLE_USER=api_user
ORACLE_PASSWORD=changeme
ORACLE_POOL_MIN=2
ORACLE_POOL_MAX=10
ORACLE_POOL_INCREMENT=1

# PostgreSQL (internal user & permission management)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=api_hub
POSTGRES_USER=api_hub
POSTGRES_PASSWORD=changeme

# JWT Authentication
SECRET_KEY=replace-with-a-secure-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# API Settings
API_TITLE=Oracle API Hub
API_VERSION=1.0.0
API_PREFIX=/api/v1
DEBUG=false

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# SQL Definitions directory
SQL_DEFINITIONS_DIR=app/sql_definitions

# Per-principal concurrency cap (complements RATE_LIMIT_PER_MINUTE, which only
# counts request starts). 0 disables the cap; CONCURRENCY_WAIT_SECONDS=0 rejects
# immediately instead of queueing for a slot.
MAX_CONCURRENT_REQUESTS_PER_PRINCIPAL=4
CONCURRENCY_WAIT_SECONDS=5.0

# Reuse a COUNT(*) across page/batch requests with identical binds. 0 disables.
QUERY_COUNT_CACHE_TTL_SECONDS=60
QUERY_COUNT_CACHE_MAX_ENTRIES=512
