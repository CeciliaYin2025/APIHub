# ==============================================================================
# Oracle API Hub — ISAP deployment environment
#   cp .env.example .env  &&  edit every <...> value
# ==============================================================================

# --- Reverse-proxy prefix (MUST match the gateway route /apihub) ---
ROOT_PATH=/apihub

# --- Platform store: shared isap-postgres (v1: shared admin user) -------------
POSTGRES_HOST=isap-postgres
POSTGRES_PORT=5432
POSTGRES_DB=apihub
POSTGRES_USER=isap_admin
POSTGRES_PASSWORD=<shared infra PG_ADMIN_PASSWORD>

# --- Celery / Redis: shared isap-redis ----------------------------------------
# Note isap-redis requires the shared password and uses `default` user.
REDIS_URL=redis://default:<REDIS_PASSWORD>@isap-redis:6379/0
CELERY_BROKER_URL=redis://default:<REDIS_PASSWORD>@isap-redis:6379/1
CELERY_RESULT_BACKEND=redis://default:<REDIS_PASSWORD>@isap-redis:6379/2

# --- JWT ----------------------------------------------------------------------
SECRET_KEY=<openssl rand -base64 48>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Data sources / targets ---------------------------------------------------
# Connections are defined in app/database_definitions/databases.yaml (mounted
# into the containers — edit + `docker compose restart` to reload, no rebuild).
# The YAML holds NO plaintext passwords; supply each one here as
# DB_{ALIAS_UPPER}_PASSWORD. One line per alias in databases.yaml.
DB_DEFAULT_PASSWORD=<oracle "default" alias password>
DB_PG_TEST_PASSWORD=<postgres "pg_test" alias password>

# Oracle thick-mode client dir (leave empty — bundled in the image via ldconfig)
ORACLE_CLIENT_DIR=
# NOTE: the legacy single-DB ORACLE_DSN/ORACLE_USER/ORACLE_PASSWORD vars are only
# a fallback used when databases.yaml is absent. Since the YAML is mounted, they
# are ignored — configure data sources in databases.yaml instead.

# --- Route-register: host dir the gateway includes confs from -----------------
INFRA_GATEWAY_APPS_DIR=/opt/isap/gateway-apps

# --- API ----------------------------------------------------------------------
API_TITLE=Oracle API Hub
API_VERSION=1.0.0
API_PREFIX=/api/v1
DEBUG=false
RATE_LIMIT_PER_MINUTE=60
SQL_DEFINITIONS_DIR=app/sql_definitions
