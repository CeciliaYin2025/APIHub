# ==============================================================================
# Oracle API Hub — MCP server (docker-compose.mcp.yml) environment
#   cp .env.mcp.example .env.mcp  &&  edit every <...> value
# ==============================================================================
# Consumed only by the apihub-mcp container.
#
# MCP_BRIDGE_SECRET is now OPTIONAL and normally left empty: with the API Hub
# running as an OAuth Resource Server (OAUTH_RS_ENABLED in .env), the MCP server
# forwards the caller's own isap-auth token and the Hub validates it itself.
# Set the secret only for a Hub that cannot accept isap-auth tokens directly;
# it must then equal the MCP_BRIDGE_SECRET in .env.

# REST API base URL (docker-internal; the MCP server is a thin proxy over it)
MCP_API_HUB_URL=http://apihub-api:8000

# stdio only: how often to poll the catalog fingerprint and push
# notifications/tools/list_changed. 0 disables it (and the advertised
# capability). No effect on this container, which runs the HTTP transport.
MCP_WATCH_INTERVAL_SECONDS=30

# --- OAuth 2.1 Resource Server ------------------------------------------------
MCP_OAUTH_ENABLED=true
# Public URL of the MCP resource as clients see it (no trailing slash)
MCP_PUBLIC_URL=https://<GATEWAY_SERVER_NAME>/apihub/mcp
# isap-auth's issuer URL (same platform Authorization Server)
MCP_AUTH_ISSUER=https://<GATEWAY_SERVER_NAME>/auth
# isap-auth introspection endpoint (docker-internal)
MCP_INTROSPECTION_URL=http://isap-auth:9997/auth/api/v1/introspect
# Shared with isap-auth's OWN OAUTH_INTROSPECTION_SECRET — copy it, don't invent.
MCP_INTROSPECTION_SECRET=<same value as isap-auth's OAUTH_INTROSPECTION_SECRET>
# Identity bridge (legacy). Leave EMPTY when the API Hub has OAUTH_RS_ENABLED=true
# — the caller's token is then forwarded unchanged, one shared secret fewer.
# If set, must be identical to MCP_BRIDGE_SECRET in .env.
MCP_BRIDGE_SECRET=
# Audience the MCP server requires in incoming tokens. Leave empty to use
# MCP_PUBLIC_URL. isap-auth serves every app on the gateway, so a token that
# merely introspects as active may have been minted for a different app —
# a token whose aud/resource claim does not name us is REJECTED (401).
#
# This only bites when isap-auth SUPPLIES an audience. As of 2026-08-31 it does
# not: it ignores the `resource` parameter clients send and its introspection
# response carries no aud/resource claim, so the check stands down rather than
# rejecting every caller (it did exactly that for 34 h — see
# mcp_server/oauth.py::token_is_for_this_server). Check for yourself with
#   curl -s -X POST $MCP_INTROSPECTION_URL -d "token=<a real token>" \
#        -H "Authorization: Bearer $MCP_INTROSPECTION_SECRET" | jq
# If a claim IS there under a different value than MCP_PUBLIC_URL (an opaque
# app id, say), set that value here and it is enforced again automatically.
MCP_OAUTH_AUDIENCE=
# Fallback while the AS returns no audience at all: accept only these client_ids
# (space- or comma-separated). Empty accepts any active isap-auth token — the
# only workable default for clients that register through DCR (Claude Code does)
# and mint a fresh client_id per install, so they cannot be listed in advance.
# Set it only where every client is registered statically.
MCP_OAUTH_ALLOWED_CLIENT_IDS=
# Scopes advertised to clients (scopes_supported + the 401 challenge's scope=).
# Space- or comma-separated; empty advertises none, and clients then request
# every scope isap-auth offers.
MCP_OAUTH_SCOPES=

# --- Transport hardening ------------------------------------------------------
# Origin/Host allow-lists for DNS-rebinding protection. Both default to values
# derived from MCP_PUBLIC_URL, which is correct behind this gateway — set these
# only if the browser-visible origin differs from the Host nginx forwards.
MCP_ALLOWED_ORIGINS=
MCP_ALLOWED_HOSTS=

# Per-request timeout for proxied REST calls, seconds. Keep it ABOVE the
# slowest exposed definition: on expiry the client reports failure and the
# model re-issues the call while the Hub is still executing the abandoned one.
MCP_REQUEST_TIMEOUT_SECONDS=120
