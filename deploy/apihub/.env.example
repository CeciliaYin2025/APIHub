# ==============================================================================
# Oracle API Hub — ISAP deployment environment
#   cp .env.example .env  &&  edit every <...> value
# ==============================================================================

# --- Reverse-proxy prefix (MUST match the gateway route /apihub) ---
ROOT_PATH=/apihub

# --- Platform store: shared isap-postgres (v1: shared admin user) -------------
POSTGRES_HOST=isap-postgres
POSTGRES_PORT=5432
POSTGRES_DB=apihub
POSTGRES_USER=isap_admin
POSTGRES_PASSWORD=<shared infra PG_ADMIN_PASSWORD>

# --- Celery / Redis: shared isap-redis ----------------------------------------
# Note isap-redis requires the shared password and uses `default` user.
REDIS_URL=redis://default:<REDIS_PASSWORD>@isap-redis:6379/0
CELERY_BROKER_URL=redis://default:<REDIS_PASSWORD>@isap-redis:6379/1
CELERY_RESULT_BACKEND=redis://default:<REDIS_PASSWORD>@isap-redis:6379/2

# --- JWT ----------------------------------------------------------------------
SECRET_KEY=<openssl rand -base64 48>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Data sources / targets ---------------------------------------------------
# Connections are defined in app/database_definitions/databases.yaml (mounted
# into the containers — edit + `docker compose restart` to reload, no rebuild).
# The YAML holds NO plaintext passwords; supply each one here as
# DB_{ALIAS_UPPER}_PASSWORD. One line per alias in databases.yaml.
DB_DEFAULT_PASSWORD=<oracle "default" alias password>
DB_PG_TEST_PASSWORD=<postgres "pg_test" alias password>

# Oracle thick-mode client dir (leave empty — bundled in the image via ldconfig)
ORACLE_CLIENT_DIR=
# NOTE: the legacy single-DB ORACLE_DSN/ORACLE_USER/ORACLE_PASSWORD vars are only
# a fallback used when databases.yaml is absent. Since the YAML is mounted, they
# are ignored — configure data sources in databases.yaml instead.

# --- Route-register: host dir the gateway includes confs from -----------------
INFRA_GATEWAY_APPS_DIR=/opt/isap/gateway-apps

# --- MCP identity bridge (apihub-api side) ------------------------------------
# The MCP *server* has its own env file now (.env.mcp / .env.mcp.example) used by
# docker-compose.mcp.yml. Only the two bridge vars below belong to apihub-api,
# which owns the identity-bridge endpoint POST /api/v1/auth/sso-token.
#
# Shared secret required in X-Bridge-Secret by that endpoint (app/api/v1/auth.py).
# Generate a fresh value per deployment; it is only ever exchanged
# docker-internally between apihub-mcp and apihub-api. MUST match the
# MCP_BRIDGE_SECRET you put in .env.mcp.
MCP_BRIDGE_SECRET=<openssl rand -base64 32>
# Auto-create a role-less local user on first SSO login via the bridge.
# Default false (site policy): unknown SSO users get 403 until an admin
# provisions them in the Admin UI instead of being silently auto-created.
MCP_BRIDGE_AUTOCREATE=false

# --- isap-auth SSO (apihub-api side) ------------------------------------------
# Admin UI SSO login via isap-auth. The registration one-shot has its own env
# file (.env.isap / .env.isap.example); only the values below belong to
# apihub-api. Leave ADMIN_SSO_ENABLED=false to keep the feature entirely off —
# both /api/v1/auth/sso/* routes then return 404 and the login page hides the
# SSO button.
ADMIN_SSO_ENABLED=true
# This service's public address. The redirect_uri handed to isap-auth is built
# from it and MUST match a line in .env.isap's ISAP_REDIRECT_URIS exactly,
# otherwise /authorize answers "Unknown app_id or redirect_uri not allowed".
APIHUB_PUBLIC_URL=https://<GATEWAY_SERVER_NAME>/apihub
# Browser-facing issuer (the /authorize redirect the user's browser follows).
ISAP_AUTH_PUBLIC_URL=https://<GATEWAY_SERVER_NAME>/auth
# Server-to-server base for POST /token — stays on the docker network.
ISAP_AUTH_INTERNAL_URL=http://isap-auth:9997/auth
# Must equal the app_id the bootstrap token was issued for.
ISAP_APP_ID=apihub
# Auto-create a role-less local user on first SSO login. Supersedes
# MCP_BRIDGE_AUTOCREATE, which is still honoured as an alias; this one flag now
# governs both the Admin UI and the MCP bridge.
SSO_AUTOCREATE=false

# --- API ----------------------------------------------------------------------
API_TITLE=Oracle API Hub
API_VERSION=1.0.0
API_PREFIX=/api/v1
DEBUG=false
RATE_LIMIT_PER_MINUTE=60
SQL_DEFINITIONS_DIR=app/sql_definitions
