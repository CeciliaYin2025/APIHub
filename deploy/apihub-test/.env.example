# ==============================================================================
# Oracle API Hub — ISAP deployment environment (TEST)
#   cp .env.example .env  &&  edit every <...> value
# ==============================================================================
# Test/UAT sibling of deploy/apihub/.env.example. Differs from prod in every
# value that touches shared infra so the two coexist.

# --- Reverse-proxy prefix (MUST match the gateway route /apihub-test) ---
ROOT_PATH=/apihub-test

# --- Platform store: shared isap-postgres (separate DB from prod!) -------------
POSTGRES_HOST=isap-postgres
POSTGRES_PORT=5432
POSTGRES_DB=apihub_test
POSTGRES_USER=isap_admin
POSTGRES_PASSWORD=<shared infra PG_ADMIN_PASSWORD>

# --- Celery / Redis: shared isap-redis ----------------------------------------
# IMPORTANT: test uses logical DBs 3/4/5 so its Celery broker/queues are isolated
# from prod (0/1/2). Reusing prod's broker DB would let a prod worker execute a
# test task (shared queue names 'write'/'procedure') and vice-versa.
REDIS_URL=redis://default:<REDIS_PASSWORD>@isap-redis:6379/3
CELERY_BROKER_URL=redis://default:<REDIS_PASSWORD>@isap-redis:6379/4
CELERY_RESULT_BACKEND=redis://default:<REDIS_PASSWORD>@isap-redis:6379/5

# --- JWT ----------------------------------------------------------------------
# Use a DIFFERENT secret from production.
SECRET_KEY=<openssl rand -base64 48 — different from prod>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Data sources / targets ---------------------------------------------------
# Connections are defined in app/database_definitions/databases.yaml (mounted).
# The YAML holds NO plaintext passwords; supply each one here as
# DB_{ALIAS_UPPER}_PASSWORD. One line per alias in databases.yaml.
DB_DEFAULT_PASSWORD=<oracle "default" alias password>
DB_PG_TEST_PASSWORD=<postgres "pg_test" alias password>

# Oracle thick-mode client dir (leave empty — bundled in the image via ldconfig)
ORACLE_CLIENT_DIR=

# --- Route-register: host dir the gateway includes confs from -----------------
INFRA_GATEWAY_APPS_DIR=/opt/isap/gateway-apps

# --- MCP identity bridge (apihub-test-api side) -------------------------------
# The MCP server has its own env file (.env.mcp / .env.mcp.example) used by
# docker-compose.mcp.yml. Only these two bridge vars belong to apihub-test-api.
# MCP_BRIDGE_SECRET MUST match the value you put in .env.mcp.
MCP_BRIDGE_SECRET=<openssl rand -base64 32>
MCP_BRIDGE_AUTOCREATE=false

# --- isap-auth SSO (apihub-test-api side) -------------------------------------
# Admin UI SSO login via isap-auth. The registration one-shot has its own env
# file (.env.isap / .env.isap.example); only the values below belong to
# apihub-test-api. Leave ADMIN_SSO_ENABLED=false to keep the feature entirely
# off — both /api/v1/auth/sso/* routes then return 404 and the login page hides
# the SSO button.
ADMIN_SSO_ENABLED=true
# This service's public address. The redirect_uri handed to isap-auth is built
# from it and MUST match a line in .env.isap's ISAP_REDIRECT_URIS exactly,
# otherwise /authorize answers "Unknown app_id or redirect_uri not allowed".
APIHUB_PUBLIC_URL=https://<GATEWAY_SERVER_NAME>/apihub-test
# Browser-facing issuer (the /authorize redirect the user's browser follows).
ISAP_AUTH_PUBLIC_URL=https://<GATEWAY_SERVER_NAME>/auth
# Server-to-server base for POST /token — stays on the docker network.
ISAP_AUTH_INTERNAL_URL=http://isap-auth:9997/auth
# Must equal the app_id the bootstrap token was issued for. The test stack has
# its own app_id, separate from production's.
ISAP_APP_ID=apihub-test
# Auto-create a role-less local user on first SSO login. Supersedes
# MCP_BRIDGE_AUTOCREATE, which is still honoured as an alias; this one flag now
# governs both the Admin UI and the MCP bridge.
SSO_AUTOCREATE=false

# --- OAuth 2.1 Resource Server (apihub-api side) ------------------------------
# Lets an OAuth client call the REST API directly with an isap-auth access
# token — no local password, no API key. The token is opaque, so every first
# use costs one introspection call to isap-auth (cached 60s per token).
# Independent of ADMIN_SSO_ENABLED: that one is the browser login, this one is
# the API. Leave false to keep the API on password JWTs + API keys only.
OAUTH_RS_ENABLED=true
# Authorization server advertised to clients. Empty falls back to
# ISAP_AUTH_PUBLIC_URL above.
OAUTH_ISSUER=https://<GATEWAY_SERVER_NAME>/auth
# Docker-internal introspection endpoint — never the public URL.
OAUTH_INTROSPECTION_URL=http://isap-auth:9997/auth/api/v1/introspect
# COPY isap-auth's own OAUTH_INTROSPECTION_SECRET here; do NOT generate a new
# one. Same value the MCP add-on uses as MCP_INTROSPECTION_SECRET.
OAUTH_INTROSPECTION_SECRET=<same value as isap-auth OAUTH_INTROSPECTION_SECRET>

# --- API ----------------------------------------------------------------------
API_TITLE=Oracle API Hub (TEST)
API_VERSION=1.0.0
API_PREFIX=/api/v1
DEBUG=false
RATE_LIMIT_PER_MINUTE=60
SQL_DEFINITIONS_DIR=app/sql_definitions
