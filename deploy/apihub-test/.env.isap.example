# ==============================================================================
# Oracle API Hub — isap-auth self-registration (apihub-test-app-register) — TEST
#   cp .env.isap.example .env.isap  &&  edit every <...> value
#   grep -nE '<[^>]+>' .env.isap    # must return nothing
# ==============================================================================
# Consumed ONLY by the apihub-test-app-register one-shot. The bootstrap token is
# deliberately kept out of .env: it can rewrite this app's redirect_uris, so a
# leak is an auth-code theft vector, and .env is shared by apihub-test-api and
# every celery worker.
#
# The test stack registers its own app_id, separate from production's — one
# bootstrap token is scoped to exactly one app_id, so they cannot share.
# Mint the token on the isap-auth host:
#   docker exec isap-auth python -m app.cli issue-token apihub-test --name "Oracle API Hub (Test)"
ISAP_REGISTRATION_TOKEN=<isapreg_... from the command above>

ISAP_APP_NAME=Oracle API Hub (Test)

# Declarative: PUT /apps/{app_id} REPLACES the registered list wholesale, so this
# is the single source of truth. Newline- or comma-separated.
# MUST match APIHUB_PUBLIC_URL in .env + /api/v1/auth/sso/callback exactly.
# isap-auth accepts https:// anywhere; http:// only on loopback hosts.
# Two entries: the Admin UI callback, and Swagger's redirect for the
# "Authorize" button (only reachable with OAUTH_RS_ENABLED, harmless otherwise).
ISAP_REDIRECT_URIS=https://<GATEWAY_SERVER_NAME>/apihub-test/api/v1/auth/sso/callback,https://<GATEWAY_SERVER_NAME>/apihub-test/docs/oauth2-redirect
