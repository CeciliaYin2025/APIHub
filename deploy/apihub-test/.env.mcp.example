# ==============================================================================
# Oracle API Hub — MCP server (docker-compose.mcp.yml) environment (TEST)
#   cp .env.mcp.example .env.mcp  &&  edit every <...> value
# ==============================================================================
# Consumed only by apihub-test-mcp.
#
# MCP_BRIDGE_SECRET is now OPTIONAL and normally left empty: with the API Hub
# running as an OAuth Resource Server (OAUTH_RS_ENABLED in .env), the MCP server
# forwards the caller's own isap-auth token and the Hub validates it itself.
# Set the secret only for a Hub that cannot accept isap-auth tokens directly;
# it must then equal the MCP_BRIDGE_SECRET in .env.

MCP_API_HUB_URL=http://apihub-test-api:8000

# Aliases to expose as tools. Empty = every alias from GET /databases, which
# also costs one definitions request per alias on every catalog load — and each
# of those is charged to the caller's REST rate limit. List only the aliases
# that actually hold definitions (in prod: DW,HRDC); add one here when you
# start defining queries on it, or its tools will never appear.
MCP_DB_ALIASES=DW,HRDC

# Per-credential tool-list cache, gated on the Hub's catalog fingerprint. This
# is the lag before a ROLE change reaches tools/list (the fingerprint does not
# cover roles). 0 disables it and every tools/list refetches every alias.
MCP_CATALOG_TTL_SECONDS=60

MCP_OAUTH_ENABLED=true
MCP_PUBLIC_URL=https://<GATEWAY_SERVER_NAME>/apihub-test/mcp
MCP_AUTH_ISSUER=https://<GATEWAY_SERVER_NAME>/auth
MCP_INTROSPECTION_URL=http://isap-auth:9997/auth/api/v1/introspect
MCP_INTROSPECTION_SECRET=<same value as isap-auth's OAUTH_INTROSPECTION_SECRET>
# Identity bridge (legacy). Leave EMPTY when the API Hub has OAUTH_RS_ENABLED=true
# — the caller's token is then forwarded unchanged, one shared secret fewer.
# If set, must be identical to MCP_BRIDGE_SECRET in .env.
MCP_BRIDGE_SECRET=
# Required audience in incoming tokens; empty = MCP_PUBLIC_URL. Tokens minted
# for another app on the gateway are rejected — but only when isap-auth emits an
# aud/resource claim at all, which today it does not. The client_id allowlist is
# the fallback for that case; empty accepts any active token (DCR clients cannot
# be listed). See deploy/apihub/.env.mcp.example for the full story.
MCP_OAUTH_AUDIENCE=
MCP_OAUTH_ALLOWED_CLIENT_IDS=
# Advertised scopes; Origin/Host allow-lists (default: derived from
# MCP_PUBLIC_URL); REST call timeout. See deploy/apihub/.env.mcp.example.
MCP_OAUTH_SCOPES=
MCP_ALLOWED_ORIGINS=
MCP_ALLOWED_HOSTS=
MCP_REQUEST_TIMEOUT_SECONDS=120
