dist/
build/
.eggs/
*.egg
.env
.env.mcp
# isap-auth self-registration bootstrap token (deploy/*/.env.isap). It can
# rewrite this app's registered redirect_uris, so a leak is an auth-code theft
# vector — same handling as .env and .env.mcp.
.env.isap
.venv/
venv/

# 資料來源連線定義:每個環境(dev/test/prod)的主機、帳號、alias 都不同,
# 因此由各環境自行維護,不進版控 —— 與 .env 相同模式。
# 新環境請複製 databases.yaml.sample 或 .example 後修改;兩份範本仍在版控中。
# 注意:改完需重啟 api + 兩個 celery worker(啟動時載入,無 hot-reload)。
app/database_definitions/databases.yaml
# 備份檔請用 .bak 結尾:DatabaseRegistry.load() 會 glob *.yaml,
# 取名 "databases copy.yaml" 之類的檔案會被當成正式定義一起載入。
app/database_definitions/*.bak
.idea/
.vscode/*
!.vscode/launch.json
*.swp
*.swo
.DS_Store
*.db
*.sqlite
.coverage
htmlcov/
.pytest_cache/
celerybeat-schedule
temp/

